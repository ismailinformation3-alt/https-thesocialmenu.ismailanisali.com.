<!DOCTYPE html><html lang="fr"> <head>   <meta charset="UTF-8">   <meta name="viewport" content="width=device-width, initial-scale=1.0">   <title>The Social Menu | Digital Marketing Agency</title>   <style>     body {       margin: 0;       font-family: Arial, Helvetica, sans-serif;       background: #f4f4f4;       color: #333;     }     header {       background: #111;       color: #fff;       padding: 50px 20px;       text-align: center;     }     header img {       max-width: 140px;       margin-bottom: 15px;     }     nav {       background: #222;       text-align: center;       padding: 10px;     }     nav button {       background: #e67e22;       color: #fff;       border: none;       padding: 8px 15px;       margin: 5px;       border-radius: 4px;       cursor: pointer;       font-size: 14px;     }     nav button:hover {       background: #cf6d17;     }     section {       max-width: 1000px;       margin: 30px auto;       background: #fff;       padding: 30px;       border-radius: 10px;     }     h2 {       color: #e67e22;     }     a {       color: #e67e22;       text-decoration: none;     }     footer {       background: #111;       color: #fff;       text-align: center;       padding: 20px;       margin-top: 40px;     }   </style> </head> <body><header>   <img src="logo.png" alt="The Social Menu Logo">   <h1>The Social Menu</h1>   <p>Digital Marketing & Content Strategy</p> </header><nav>   <button onclick="setLang('fr')">Français</button>   <button onclick="setLang('en')">English</button>   <button onclick="setLang('ar')">العربية</button> </nav><section id="main-content"></section><section>   <h2>Contact</h2>   <p><strong>WhatsApp :</strong> <a href="https://wa.me/212772827513">+212 772 827 513</a></p>   <p><strong>Email :</strong> <a href="mailto:timeismoney.bro12@gmail.com">timeismoney.bro12@gmail.com</a></p> </section><footer>   <p>© 2026 The Social Menu · All rights reserved</p> </footer><script>   const content = {     fr: {       title: "Agence de Marketing Digital",       text: "The Social Menu est une agence de marketing digital spécialisée dans la stratégie de contenu, la gestion de l’image de marque et la croissance en ligne. Nous accompagnons les entreprises et entrepreneurs dans le développement de leur présence digitale, l’augmentation de leur visibilité et la transformation de leur audience en clients réels grâce à des solutions professionnelles et orientées résultats."     },     en: {       title: "Digital Marketing Agency",       text: "The Social Menu is a digital marketing agency specialized in content strategy, brand positioning, and online growth. We help businesses and entrepreneurs build strong digital identities, increase visibility, and turn attention into measurable business results through professional, result-driven solutions."     },     ar: {       title: "وكالة تسويق رقمي",       text: "The Social Menu هي وكالة تسويق رقمي متخصصة في استراتيجيات المحتوى وبناء العلامة التجارية والنمو الرقمي. نساعد الشركات ورواد الأعمال على تعزيز حضورهم على الإنترنت، زيادة الظهور، وتحويل المتابعين إلى عملاء حقيقيين من خلال حلول احترافية موجهة نحو النتائج."     }   };    function setLang(lang) {     const section = document.getElementById('main-content');     section.innerHTML = `<h2>${content[lang].title}</h2><p>${content[lang].text}</p>`;     document.documentElement.lang = lang;     document.body.dir = lang === 'ar' ? 'rtl' : 'ltr';   }    setLang('fr'); </script></body> </html>
